{
  "name": "jontro",
  "private": true,
  "version": "1.0.24",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -b && vite build && electron-builder --publish never",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch:tessdata": "node scripts/fetch-tessdata.mjs"
  },
  "build": {
    "appId": "com.jontro.app",
    "productName": "Jontro",
    "publish": {
      "provider": "github",
      "owner": "zihaaaad",
      "repo": "Jontro"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**"
    ],
    "files": [
      "package.json",
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/firebase/**",
      "!node_modules/@firebase/**"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/zxcvbn": "^4.4.5",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.0",
    "fluent-ffmpeg": "^2.1.3",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "sonner": "^2.0.7",
    "tesseract.js": "^7.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
